# Port the Express server listens on
PORT=4000

# Origin(s) allowed by CORS — the frontend's dev/prod URL, e.g. http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Firebase project id (used for verifying tokens are issued for the right project)
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Firebase Admin credentials: set EXACTLY ONE of the following two ---

# Option A: paste the full service account JSON as a single-line string.
# On Windows/PowerShell you can produce this with:
#   (Get-Content serviceAccount.json -Raw) -replace "`r`n","" -replace "`n",""
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# Option B: path to a service account key file on disk. If this is set,
# the Google SDK default credential loader is used instead.
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json
